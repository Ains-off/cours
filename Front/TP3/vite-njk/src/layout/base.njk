<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8"/>
        <link rel="icon" type="image/svg+xml" href="/vite.svg"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>{% block title %}Il me faut un titre{% endblock %}</title>
        <link rel="stylesheet" href="/assets/css/reset.css">
        <link rel="stylesheet" href="/assets/css/fonts.css">
        <script type="module" src="/src/scripts/main.js" defer></script>
    </head>
    <body class="container-1280">
        {% include "composants/navigation.njk" %}
        <main>
            <h1 class="titre">{% block titleh1 %}Il me faut un titre de section{% endblock %}</h1>
            <ul class="pastries-list">
                <li class="pastry">
                    <figure>
                        <img src='/assets/images/brioche-cannelle.jpg' alt='' loading="lazy">
                    </figure>
                    <section class='textes'>
                        <h2 class='titre'>Brioche à la cannelle ou Kanelbulle</h2>
                        <p class='description'>
                            1,75 € / unité
                        </p>
                    </section>
                </li>
                <li class="pastry">
                    <figure>
                        <img src='/assets/images/lunettes.jpg' alt='' loading="lazy">
                    </figure>
                    <section class='textes'>
                        <h2 class='titre'>Lunettes fraise ou abricot</h2>
                        <p class='description'>
                            1,5 € / unité
                        </p>
                    </section>
                </li>
                <li class="pastry">
                    <figure>
                        <img src='/assets/images/macarons.jpg' alt='' loading="lazy">
                    </figure>
                    <section class='textes'>
                        <h2 class='titre'>Macarons (plusieurs goûts)</h2>
                        <p class='description'>
                            20 € / la douzaine
                        </p>
                    </section>
                </li>
                <li class="pastry">
                    <figure>
                        <img src='/assets/images/opera-the-matcha.jpg' alt='' loading="lazy">
                    </figure>
                    <section class='textes'>
                        <h2 class='titre'>Opéra au thé matcha</h2>
                        <p class='description'>
                            4.5 € / la part
                        </p>
                    </section>
                </li>
                <li class="pastry">
                    <figure>
                        <img src='/assets/images/financiers.jpg' alt='' loading="lazy">
                    </figure>
                    <section class='textes'>
                        <h2 class='titre'>Financiers</h2>
                        <p class='description'>
                            5 € / la demi-douzaine
                        </p>
                    </section>
                </li>
            </ul>
        </main>

        {% set humeur = "tired" %}

            {% if humeur == "hungry" %}
            I am hungry
            {% elif humeur == "tired" %}
            I am tired
            {% else %}
            I am good!
            {% endif %}


        <footer class="footer">
            <p>Crédits Le ptit chef - 2003-2024</p>
        </footer>
    </body>
</html>